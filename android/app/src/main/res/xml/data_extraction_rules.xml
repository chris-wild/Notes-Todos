<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Cloud backup: DB + settings only. Recipe PDFs are excluded (25 MB cap)
     and covered by the in-app export instead. The Anthropic key never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recipes/" />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
