<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the source art's subtle vertical gradient so the foreground crop
     (which carries the same background in its pixels) blends seamlessly. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FAFAFA"
        android:centerColor="#E7E7E7"
        android:endColor="#D2D2D2" />
</shape>
